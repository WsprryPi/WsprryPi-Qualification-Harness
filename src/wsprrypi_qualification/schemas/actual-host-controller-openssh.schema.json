{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schema_version","evidence_type","evidence_timing","path","size_bytes","sha256","version_arguments","started_utc","completed_utc","return_code","stdout","stderr","historical_identity_limit"],"properties":{"schema_version":{"const":1},"evidence_type":{"const":"actual_host_controller_openssh_identity"},"evidence_timing":{"const":"current_local_retrospective_context"},"path":{"const":"/usr/bin/ssh"},"size_bytes":{"type":"integer","minimum":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"version_arguments":{"const":["/usr/bin/ssh","-V"]},"started_utc":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},"completed_utc":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},"return_code":{"const":0},"stdout":{"const":""},"stderr":{"type":"string","pattern":"^OpenSSH_"},"historical_identity_limit":{"const":"Current local identity only; original records retain this path but not its run-time hash."}}}
