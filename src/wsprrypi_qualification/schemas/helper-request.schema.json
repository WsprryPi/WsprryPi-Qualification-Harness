{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["protocol_version","request_id","operation","plan_sha256","payload"],
  "properties":{"protocol_version":{"const":1},"request_id":{"type":"string","minLength":1},"operation":{"enum":["process-start","process-wait","process-stop","service-inspect","service-set","gpio-inspect","si5351-inspect","bounded-tone"]},"plan_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"payload":{"type":"object"}},
  "allOf":[
    {"if":{"properties":{"operation":{"const":"process-start"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/process_start"}}}},
    {"if":{"properties":{"operation":{"const":"process-wait"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/process_wait"}}}},
    {"if":{"properties":{"operation":{"const":"process-stop"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/process_stop"}}}},
    {"if":{"properties":{"operation":{"const":"service-inspect"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/service_inspect"}}}},
    {"if":{"properties":{"operation":{"const":"service-set"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/service_set"}}}},
    {"if":{"properties":{"operation":{"const":"gpio-inspect"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/gpio"}}}},
    {"if":{"properties":{"operation":{"const":"si5351-inspect"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/si5351"}}}},
    {"if":{"properties":{"operation":{"const":"bounded-tone"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/bounded_tone"}}}}
  ],
  "$defs":{
    "process_start":{"type":"object","additionalProperties":false,"required":["arguments","executable_sha256","pinned_arguments","hard_timeout_s","environment"],"properties":{"arguments":{"type":"array","minItems":1,"items":{"type":"string"}},"executable_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"pinned_arguments":{"type":"object","propertyNames":{"pattern":"^/.+"},"additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"hard_timeout_s":{"type":"number","exclusiveMinimum":0},"environment":{"type":"object","additionalProperties":{"type":"string"}}}},
    "process_wait":{"type":"object","additionalProperties":false,"required":["handle_id","timeout_s"],"properties":{"handle_id":{"type":"string","minLength":1},"timeout_s":{"type":"number","exclusiveMinimum":0}}},
    "process_stop":{"type":"object","additionalProperties":false,"required":["handle_id"],"properties":{"handle_id":{"type":"string","minLength":1}}},
    "service_inspect":{"type":"object","additionalProperties":false,"required":["name","manager"],"properties":{"name":{"type":"string","minLength":1},"manager":{"type":"string","minLength":1}}},
    "service_set":{"type":"object","additionalProperties":false,"required":["name","manager","running"],"properties":{"name":{"type":"string","minLength":1},"manager":{"type":"string","minLength":1},"running":{"type":"boolean"}}},
    "gpio":{"type":"object","additionalProperties":false,"required":["pin"],"properties":{"pin":{"type":"integer","minimum":0}}},
    "si5351":{"type":"object","additionalProperties":false,"required":["bus","address"],"properties":{"bus":{"type":"integer","minimum":0},"address":{"type":"string","minLength":1}}},
    "bounded_tone":{"type":"object","additionalProperties":false,"required":["frequency_hz","duration_ms","outer_timeout_s"],"properties":{"frequency_hz":{"type":"integer","minimum":1},"duration_ms":{"type":"integer","minimum":1,"maximum":60000},"outer_timeout_s":{"type":"number","exclusiveMinimum":0}}}
  }
}
