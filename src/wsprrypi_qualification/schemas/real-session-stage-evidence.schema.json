{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_type", "plan_sha256", "outcome", "elapsed_s", "deadline_s", "details"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_type": {"enum": ["capabilities", "helper", "ownership", "rf_idle", "cleanup_registration", "capture", "carrier_analysis", "decode_summary", "cleanup", "quiescence"]},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome": {"enum": ["passed", "completed", "verified", "failed", "blocked", "inconclusive"]},
    "elapsed_s": {"type": "number", "minimum": 0},
    "deadline_s": {"type": "number", "exclusiveMinimum": 0},
    "details": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"evidence_type": {"const": "capture"}}, "required": ["evidence_type"]}, "then": {"properties": {"details": {"$ref": "#/$defs/capture"}}}},
    {"if": {"properties": {"evidence_type": {"const": "carrier_analysis"}}, "required": ["evidence_type"]}, "then": {"properties": {"details": {"$ref": "#/$defs/carrier"}}}},
    {"if": {"properties": {"evidence_type": {"const": "decode_summary"}}, "required": ["evidence_type"]}, "then": {"properties": {"details": {"$ref": "#/$defs/decode"}}}}
    ,{"if": {"properties": {"evidence_type": {"const": "capabilities"}}, "required": ["evidence_type"]}, "then": {"properties": {"details": {"$ref": "#/$defs/capabilities"}}}}
    ,{"if": {"properties": {"evidence_type": {"const": "helper"}}, "required": ["evidence_type"]}, "then": {"properties": {"details": {"$ref": "#/$defs/helper"}}}}
    ,{"if": {"properties": {"evidence_type": {"const": "ownership"}}, "required": ["evidence_type"]}, "then": {"properties": {"details": {"$ref": "#/$defs/ownership"}}}}
    ,{"if": {"properties": {"evidence_type": {"enum": ["rf_idle", "quiescence"]}}, "required": ["evidence_type"]}, "then": {"properties": {"details": {"$ref": "#/$defs/quiescence"}}}}
    ,{"if": {"properties": {"evidence_type": {"const": "cleanup_registration"}}, "required": ["evidence_type"]}, "then": {"properties": {"details": {"$ref": "#/$defs/registration"}}}}
    ,{"if": {"properties": {"evidence_type": {"const": "cleanup"}}, "required": ["evidence_type"]}, "then": {"properties": {"details": {"$ref": "#/$defs/cleanup"}}}}
  ],
  "$defs": {
    "capabilities": {"type": "object", "additionalProperties": false, "required": ["bindings"], "properties": {"bindings": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "helperIdentity": {"type": "object", "additionalProperties": false, "required": ["host", "path", "sha256", "identity", "config_path", "config_sha256"], "properties": {"host": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "identity": {"type": "string", "minLength": 1}, "config_path":{"type":"string","minLength":1},"config_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "helperVerificationContract": {"type": "object", "additionalProperties": false, "required": ["operations", "per_operation_deadline_s", "aggregate_deadline_s"], "properties": {"operations": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["transmitter_service_inspect", "receiver_service_inspect", "parent_revision_inspect", "submodule_revision_inspect"]}}, "per_operation_deadline_s": {"type": "number", "exclusiveMinimum": 0}, "aggregate_deadline_s": {"type": "number", "exclusiveMinimum": 0}}},
    "helper": {"type": "object", "additionalProperties": false, "required": ["transmitter", "receiver"], "properties": {"transmitter": {"$ref": "#/$defs/helperIdentity"}, "receiver": {"$ref": "#/$defs/helperIdentity"}, "verification_contract": {"$ref": "#/$defs/helperVerificationContract"}}},
    "ownershipHost": {"type":"object","additionalProperties":false,"required":["host","services","conflicts"],"properties":{"host":{"type":"string","minLength":1},"services":{"type":"array","items":{"type":"string"},"uniqueItems":true},"conflicts":{"type":"array","maxItems":0}}},
    "ownership": {"type": "object", "additionalProperties": false, "required": ["transmitter", "receiver"], "properties": {"transmitter":{"$ref":"#/$defs/ownershipHost"},"receiver":{"$ref":"#/$defs/ownershipHost"}}},
    "quiescence": {"type": "object", "additionalProperties": false, "required": ["backend", "output", "verified"], "properties": {"backend": {"enum": ["gpio", "si5351"]}, "output": {"type": "string", "minLength": 1}, "verified": {"type": "boolean"}, "failure": {"type": "string"}}},
    "registration": {"type": "object", "additionalProperties": false, "required": ["installed", "deadline_s"], "properties": {"installed": {"const": true}, "deadline_s": {"type": "number", "exclusiveMinimum": 0}}},
    "cleanup": {"type": "object", "additionalProperties": false, "required": ["actions_complete", "helper_absent"], "properties": {"actions_complete": {"type": "boolean"}, "helper_absent": {"type": "boolean"}, "failure": {"type": "string"}}},
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["capture_kind", "sample_format", "sample_rate_hz", "sample_count", "overflow_count", "timeout_count", "clipped_samples", "receiver_host", "driver", "serial", "artifact_sha256"],
      "properties": {
        "capture_kind": {"enum": ["rf_off", "rf_on", "coherent"]}, "sample_format": {"const": "CF32"}, "sample_rate_hz": {"const": 250000}, "sample_count": {"type": "integer", "minimum": 1},
        "overflow_count": {"const": 0}, "timeout_count": {"const": 0}, "clipped_samples": {"const": 0}, "receiver_host": {"type": "string", "minLength": 1}, "driver": {"type": "string", "minLength": 1}, "serial": {"type": "string", "minLength": 1}, "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "carrier": {
      "type": "object", "additionalProperties": false,
      "required": ["gate_outcome", "requested_frequency_hz", "strongest_frequency_hz", "offset_hz", "best_20hz_fraction", "strongest_contrast_db", "carrier_gate_policy", "relative_acquisition_offset_gate_hz", "relative_acquisition_contrast_gate_db"],
      "properties": {"gate_outcome": {"enum": ["passed", "failed", "blocked", "inconclusive"]}, "mode_gate": {"enum": ["not_applicable", "passed", "failed", "blocked", "inconclusive"]}, "requested_frequency_hz": {"type": "number", "exclusiveMinimum": 0}, "strongest_frequency_hz": {"type": "number", "exclusiveMinimum": 0}, "offset_hz": {"type": "number"}, "best_20hz_fraction": {"type": "number", "minimum": 0, "maximum": 1}, "strongest_contrast_db": {"type": "number"}, "carrier_gate_policy": {"const": "bounded_relative_carrier_acquisition"}, "relative_acquisition_offset_gate_hz": {"const": 500.0}, "relative_acquisition_contrast_gate_db": {"const": 10.0}, "receiver_frequency_interpretation": {"type": ["object", "null"]}}
    },
    "slot": {
      "type": "object", "additionalProperties": false,
      "required": ["slot_utc", "callsign", "grid", "power_dbm", "matched", "wsprd_log_sha256"],
      "properties": {"slot_utc": {"type": "string", "format": "date-time"}, "callsign": {"type": "string", "minLength": 1}, "grid": {"type": "string", "minLength": 4}, "power_dbm": {"type": "integer"}, "matched": {"type": "boolean"}, "wsprd_log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "decode": {
      "type": "object", "additionalProperties": false, "required": ["gate_outcome", "slots"],
      "properties": {"gate_outcome": {"enum": ["passed", "failed", "blocked", "inconclusive"]}, "slots": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/slot"}}}
    }
  }
}
