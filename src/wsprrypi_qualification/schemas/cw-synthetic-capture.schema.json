{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_type", "run_id", "mode", "plan", "expected_events", "capture", "seed", "overflow_count", "synthetic"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_type": {"const": "cw_synthetic_capture"},
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["tone", "cw", "qrss", "fskcw", "dfcw"]},
    "plan": {"$ref": "#/$defs/artifact"},
    "expected_events": {"$ref": "#/$defs/artifact"},
    "capture": {"$ref": "#/$defs/artifact"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "overflow_count": {"const": 0},
    "synthetic": {"const": true}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
