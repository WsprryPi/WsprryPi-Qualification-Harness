{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rp1-preflight-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["host", "endpoint", "endpoint_type", "endpoint_owner", "endpoint_group", "endpoint_mode", "endpoint_device_identity", "endpoint_available", "endpoint_open", "owner_present", "lease_present", "module", "module_version", "module_build_id", "uapi_sha256", "vermagic", "signer", "installed_module_sha256", "abi_version", "query_version", "finite_tone", "live_output", "route", "endpoint_node", "compatibility_id", "compatibility_state", "compatibility_reason", "development_enrollment", "development_manifest_sha256", "live_eligible", "operation_live_gate", "cleanup_fault", "generation", "operation_state", "terminal_reason", "current_event", "elapsed_ns", "remaining_ns", "drain_complete", "gpio_safe", "clock_quiescent", "dma_quiescent", "unresolved_route_transaction", "route_state"],
  "properties": {
    "host": {"type": "string", "minLength": 1},
    "endpoint": {"const": "/dev/rp1-gpclk"},
    "endpoint_type": {"const": "character"},
    "endpoint_owner": {"type": "string", "minLength": 1},
    "endpoint_group": {"type": "string", "minLength": 1},
    "endpoint_mode": {"const": "0600"},
    "endpoint_device_identity": {"type": "string", "minLength": 1},
    "endpoint_available": {"type": "boolean"},
    "endpoint_open": {"type": "boolean"},
    "owner_present": {"type": "boolean"},
    "lease_present": {"type": "boolean"},
    "module": {"const": "rp1_gpclk_dkms"},
    "module_version": {"type": "string", "minLength": 1},
    "module_build_id": {"type": "string", "minLength": 1},
    "uapi_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vermagic": {"type": "string", "minLength": 1},
    "signer": {"type": "string", "minLength": 1},
    "installed_module_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "abi_version": {"const": 4},
    "query_version": {"const": 3},
    "finite_tone": {"type": "boolean"},
    "live_output": {"type": "boolean"},
    "route": {"enum": ["gpio4", "gpio20"]},
    "endpoint_node": {"enum": ["rp1-gpclk-dkms-gpio4", "rp1-gpclk-dkms-gpio20"]},
    "compatibility_id": {"type": "string", "minLength": 1},
    "compatibility_state": {"const": "Experimental"},
    "compatibility_reason": {"type": "string", "minLength": 1},
    "development_enrollment": {"const": "Experimental"},
    "development_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "live_eligible": {"type": "boolean"},
    "operation_live_gate": {"type": "boolean"},
    "cleanup_fault": {"type": "boolean"},
    "generation": {"type": "integer", "minimum": 0},
    "operation_state": {"const": "IDLE"},
    "terminal_reason": {"type": "string", "minLength": 1},
    "current_event": {"type": "string", "minLength": 1},
    "elapsed_ns": {"type": "integer", "minimum": 0},
    "remaining_ns": {"type": "integer", "minimum": 0},
    "drain_complete": {"type": "boolean"},
    "gpio_safe": {"type": "boolean"},
    "clock_quiescent": {"type": "boolean"},
    "dma_quiescent": {"type": "boolean"},
    "unresolved_route_transaction": {"type": "boolean"},
    "route_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "saved", "configured", "active_overlay", "module_reported", "reconciled"],
      "properties": {
        "requested": {"enum": ["gpio4", "gpio20"]},
        "saved": {"enum": ["gpio4", "gpio20"]},
        "configured": {"enum": ["gpio4", "gpio20"]},
        "active_overlay": {"enum": ["gpio4", "gpio20"]},
        "module_reported": {"enum": ["gpio4", "gpio20"]},
        "reconciled": {"enum": ["gpio4", "gpio20"]}
      }
    }
  }
}
