{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "request",
    "sources",
    "tools",
    "controller",
    "mechanics",
    "publication_enabled",
    "scope",
    "components",
    "evidence",
    "prepared_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "prepared-release"
    },
    "request": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "scope": {
          "enum": [
            "pi",
            "pico",
            "rp1",
            "system"
          ]
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "pi": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string",
                  "pattern": "^v[0-9]"
                },
                "publish": {
                  "type": "boolean"
                },
                "ci_run": {
                  "type": "integer",
                  "minimum": 1
                },
                "mode": {
                  "enum": [
                    "build",
                    "exports",
                    "packet"
                  ]
                },
                "public_branch": {
                  "type": "string",
                  "minLength": 1
                },
                "pico_source": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "exports": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "armv6-bookworm": {
                      "type": "string",
                      "minLength": 1
                    },
                    "armv6-trixie": {
                      "type": "string",
                      "minLength": 1
                    },
                    "aarch64-bookworm": {
                      "type": "string",
                      "minLength": 1
                    },
                    "aarch64-trixie": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "armv6-bookworm",
                    "armv6-trixie",
                    "aarch64-bookworm",
                    "aarch64-trixie"
                  ]
                },
                "packet": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source",
                "version",
                "tag",
                "publish",
                "ci_run",
                "mode",
                "public_branch",
                "pico_source"
              ]
            },
            "pico": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string",
                  "pattern": "^v[0-9]"
                },
                "publish": {
                  "type": "boolean"
                },
                "ci_run": {
                  "type": "integer",
                  "minimum": 1
                },
                "mode": {
                  "enum": [
                    "ci"
                  ]
                },
                "tooling_source": {
                  "type": "string",
                  "minLength": 1
                },
                "branch": {
                  "enum": [
                    "devel",
                    "main",
                    "release"
                  ]
                },
                "attempt": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "source",
                "version",
                "tag",
                "publish",
                "ci_run",
                "mode",
                "tooling_source",
                "branch",
                "attempt"
              ]
            },
            "rp1": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string",
                  "pattern": "^v[0-9]"
                },
                "publish": {
                  "type": "boolean"
                },
                "ci_run": {
                  "type": "integer",
                  "minimum": 1
                },
                "mode": {
                  "enum": [
                    "build",
                    "candidate"
                  ]
                },
                "consumer_source": {
                  "type": "string",
                  "minLength": 1
                },
                "image": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "candidate": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source",
                "version",
                "tag",
                "publish",
                "ci_run",
                "mode",
                "consumer_source",
                "image"
              ]
            }
          }
        },
        "pi_dependencies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pico": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source",
                "version"
              ]
            },
            "rp1": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source",
                "version"
              ]
            }
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "git": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "python": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "gh": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "docker": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "pico_selection": {
          "enum": [
            "default",
            "explicit"
          ]
        }
      },
      "required": [
        "schema_version",
        "scope",
        "components"
      ]
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "repository",
          "commit",
          "tree",
          "branch"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "tree": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          }
        }
      }
    },
    "tools": {
      "type": "object"
    },
    "controller": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "mechanics": {
      "type": "object"
    },
    "publication_enabled": {
      "const": false
    },
    "scope": {
      "enum": [
        "pi",
        "pico",
        "rp1",
        "system"
      ]
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "component",
          "repository",
          "source",
          "version",
          "tag",
          "directory",
          "validation",
          "files",
          "packet_sha256",
          "publish_selected"
        ],
        "properties": {
          "files": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bytes",
                "sha256"
              ],
              "properties": {
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "packet_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "publish_selected": {
            "type": "boolean"
          },
          "validation": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bytes",
          "sha256"
        ],
        "properties": {
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "prepared_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
