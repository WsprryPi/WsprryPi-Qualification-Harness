{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "evidence_type", "run_id", "mode", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_type": {"const": "cw_replay_evidence_index"},
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["tone", "cw", "qrss", "fskcw", "dfcw"]},
    "artifacts": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "path", "size_bytes", "sha256"],
        "properties": {
          "role": {"enum": ["plan", "expected_events", "capture_metadata", "capture_iq", "observations", "mode_gate", "receiver_calibration"]},
          "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
