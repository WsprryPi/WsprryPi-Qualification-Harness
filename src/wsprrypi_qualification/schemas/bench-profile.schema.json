{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WsprryPi/WsprryPi-Qualification-Harness/schemas/bench-profile.schema.json",
  "title": "WsprryPi qualification bench profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bench_id", "receiver", "rf_path"],
  "properties": {
    "schema_version": {"const": 1},
    "bench_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,61}[a-z0-9_-])$",
      "not": {"pattern": "\\.\\."}
    },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "driver", "sample_rate_hz", "bandwidth_hz", "sample_format", "agc", "bias_tee"],
      "properties": {
        "transport": {"enum": ["local", "ssh"]},
        "host": {"type": "string", "minLength": 1},
        "driver": {"type": "string", "minLength": 1},
        "serial": {"type": "string", "minLength": 1},
        "channel": {"type": "integer", "minimum": 0},
        "sample_rate_hz": {"type": "integer", "minimum": 1},
        "bandwidth_hz": {"type": "integer", "minimum": 1},
        "sample_format": {"const": "CF32"},
        "agc": {"const": false},
        "bias_tee": {"const": false}
      },
      "allOf": [
        {"if": {"properties": {"transport": {"const": "ssh"}}}, "then": {"required": ["host"]}}
      ]
    },
    "rf_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_type", "antenna_connected", "attenuation_db", "filter_description", "safe_input_description"],
      "properties": {
        "path_type": {"enum": ["conducted", "radiated", "unknown", "other"]},
        "antenna_connected": {"type": ["boolean", "null"]},
        "termination_ohms": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "attenuation_db": {"type": ["number", "null"], "minimum": 0},
        "filter_description": {"type": "string", "minLength": 1},
        "safe_input_description": {"type": "string", "minLength": 1}
      }
    }
  }
}
