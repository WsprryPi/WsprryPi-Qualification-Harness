{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "plan_sha256",
    "status",
    "simulated",
    "qualification_claim",
    "carrier_gate",
    "decode_gate",
    "cleanup_outcome",
    "cause"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-.+$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "inconclusive",
        "unqualified_carrier",
        "aborted",
        "cleanup_failed"
      ]
    },
    "simulated": {
      "const": true
    },
    "qualification_claim": {
      "const": false
    },
    "carrier_gate": {
      "enum": [
        "not_run",
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "decode_gate": {
      "enum": [
        "not_run",
        "passed",
        "failed"
      ]
    },
    "cleanup_outcome": {
      "enum": [
        "verified",
        "failed"
      ]
    },
    "cause": {
      "type": "string",
      "minLength": 1
    }
  }
}
