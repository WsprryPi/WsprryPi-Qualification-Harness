{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_type",
    "run_id",
    "simulated",
    "qualification_claim",
    "plan_sha256",
    "timing",
    "events",
    "children",
    "carrier_gate",
    "decode_gate",
    "cleanup_outcome",
    "final_status",
    "failure_causes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evidence_type": {
      "const": "qualification_simulator_session"
    },
    "run_id": {
      "type": "string"
    },
    "simulated": {
      "const": true
    },
    "qualification_claim": {
      "const": false
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_duration_s",
        "actual_elapsed_s",
        "time_scale",
        "overall_deadline_s",
        "child_deadline_s"
      ],
      "properties": {
        "logical_duration_s": {
          "const": 370
        },
        "actual_elapsed_s": {
          "type": "number",
          "minimum": 0
        },
        "time_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "overall_deadline_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "child_deadline_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "phase",
          "outcome"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "phase": {
            "enum": [
              "preflight",
              "cleanup_registered",
              "rf_off",
              "carrier",
              "carrier_gate",
              "frames",
              "decode",
              "cleanup",
              "quiescence"
            ]
          },
          "outcome": {
            "enum": [
              "passed",
              "verified",
              "completed",
              "failed",
              "inconclusive"
            ]
          }
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "executable",
          "executable_sha256",
          "arguments",
          "return_code",
          "timed_out",
          "stdout",
          "stderr",
          "elapsed_s",
          "terminated",
          "reaped",
          "descendant_cleanup",
          "cleanup_verified"
        ],
        "properties": {
          "name": {
            "enum": ["receiver-rf-off", "transmitter-carrier", "transmitter-frames"]
          },
          "role": {
            "enum": ["receiver-rf-off", "transmitter-carrier", "transmitter-frames"]
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "executable_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "return_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "timed_out": {
            "type": "boolean"
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "elapsed_s": {
            "type": "number",
            "minimum": 0
          },
          "terminated": {
            "type": "boolean"
          },
          "reaped": {
            "type": "boolean"
          },
          "descendant_cleanup": {
            "enum": ["verified_no_descendants", "unsupported", "unverified"]
          },
          "cleanup_verified": {
            "type": "boolean"
          }
        }
      }
    },
    "carrier_gate": {
      "enum": [
        "not_run",
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "decode_gate": {
      "enum": [
        "not_run",
        "passed",
        "failed"
      ]
    },
    "cleanup_outcome": {
      "enum": [
        "verified",
        "failed"
      ]
    },
    "final_status": {
      "enum": [
        "aborted",
        "unqualified_carrier",
        "cleanup_failed",
        "inconclusive"
      ]
    },
    "failure_causes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
