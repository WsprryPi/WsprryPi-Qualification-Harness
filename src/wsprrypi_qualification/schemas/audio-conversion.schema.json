{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WsprryPi/WsprryPi-Qualification-Harness/schemas/audio-conversion.schema.json",
  "$defs": {
    "artifact": {"type":"object","additionalProperties":false,"required":["path","size_bytes","sha256"],"properties":{"path":{"type":"string","minLength":1},"size_bytes":{"type":"integer","minimum":0},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "profileArtifact": {"type":"object","additionalProperties":false,"required":["path","size_bytes","sha256","id","schema_version"],"properties":{"path":{"type":"string","minLength":1},"size_bytes":{"type":"integer","minimum":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"id":{"type":"string","minLength":1},"schema_version":{"const":1}}}
  },
  "title":"Offline CF32 to WSPR WAV evidence","type":"object","additionalProperties":false,
  "required":["schema_version","evidence_type","slot_utc","input","output","contract","conjugate_policy","profiles","capture","publication"],
  "properties":{
    "schema_version":{"const":1},"evidence_type":{"const":"audio_conversion"},"slot_utc":{"type":"string","format":"date-time","pattern":"Z$"},
    "input":{"type":"object","additionalProperties":false,"required":["path","sample_count","size_bytes","sha256","peak_magnitude","peak_component","clipping_threshold","clipped_samples"],"properties":{"path":{"type":"string","minLength":1},"sample_count":{"type":"integer","minimum":1},"size_bytes":{"type":"integer","minimum":8},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"peak_magnitude":{"type":"number","minimum":0},"peak_component":{"type":"number","minimum":0},"clipping_threshold":{"type":"number","exclusiveMinimum":0},"clipped_samples":{"const":0}}},
    "output":{"$ref":"#/$defs/artifact"},
    "contract":{"type":"object","additionalProperties":false,"required":["sample_rate_hz","center_frequency_hz","selected_frequency_hz","output_rate_hz","target_audio_hz","frame_duration_s","filter_taps","required_margin_s","mix_hz","mix_formula","resampler","wav_format","input_start_sample","input_sample_count","output_sample_count","normalization_scale"],"properties":{"sample_rate_hz":{"type":"integer","minimum":1},"center_frequency_hz":{"type":"number"},"selected_frequency_hz":{"type":"number"},"output_rate_hz":{"const":12000},"target_audio_hz":{"const":1500.0},"frame_duration_s":{"const":120},"filter_taps":{"const":64},"required_margin_s":{"const":5},"mix_hz":{"type":"number"},"mix_formula":{"const":"real(iq[n] * exp(-j*2*pi*mix_hz*n/fs))"},"resampler":{"const":"windowed_sinc_hann"},"wav_format":{"const":"mono_pcm_s16le"},"input_start_sample":{"type":"integer","minimum":0},"input_sample_count":{"type":"integer","minimum":1},"output_sample_count":{"const":1440000},"normalization_scale":{"type":"number","exclusiveMinimum":0}}},
    "conjugate_policy":{"const":"expected decode is nearest positive target_audio_hz; other real-audio images are companions"},
    "profiles":{"type":"object","additionalProperties":false,"required":["bench","test","resolved"],"properties":{"bench":{"$ref":"#/$defs/profileArtifact"},"test":{"$ref":"#/$defs/profileArtifact"},"resolved":{"type":"object","additionalProperties":false,"required":["receiver","requested_frequency_hz","receiver_center_hz","receiver_gain_db","identity","gates","frame_count","random_offset_enabled"],"properties":{"receiver":{"type":"object","additionalProperties":false,"required":["transport","driver","sample_rate_hz","bandwidth_hz","sample_format","agc","bias_tee"],"properties":{"transport":{"enum":["local","ssh"]},"host":{"type":"string","minLength":1},"driver":{"type":"string","minLength":1},"serial":{"type":"string","minLength":1},"channel":{"type":"integer","minimum":0},"sample_rate_hz":{"type":"integer","minimum":1},"bandwidth_hz":{"type":"integer","minimum":1},"sample_format":{"const":"CF32"},"agc":{"const":false},"bias_tee":{"const":false}}},"requested_frequency_hz":{"type":"number","exclusiveMinimum":0},"receiver_center_hz":{"type":"number","exclusiveMinimum":0},"receiver_gain_db":{"type":"number"},"identity":{"type":"object","additionalProperties":false,"required":["callsign","grid","power_dbm"],"properties":{"callsign":{"type":"string","pattern":"^[A-Z0-9/]{3,12}$"},"grid":{"type":"string","pattern":"^[A-R]{2}[0-9]{2}([A-X]{2})?$"},"power_dbm":{"type":"integer"}}},"gates":{"type":"object","additionalProperties":false,"required":["carrier_offset_max_hz","best_20hz_share_min","required_consecutive_decodes"],"properties":{"carrier_offset_max_hz":{"type":"number","minimum":0},"best_20hz_share_min":{"type":"number","minimum":0,"maximum":1},"required_consecutive_decodes":{"type":"integer","minimum":1}}},"frame_count":{"type":"integer","minimum":1},"random_offset_enabled":{"const":false}}}}},
    "capture":{"type":"object","additionalProperties":false,"required":["path","size_bytes","sha256","capture_id","retained_capture_start_utc","retained_sample_count"],"properties":{"path":{"type":"string","minLength":1},"size_bytes":{"type":"integer","minimum":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"capture_id":{"type":"string","minLength":1},"retained_capture_start_utc":{"type":"string","format":"date-time","pattern":"Z$"},"retained_sample_count":{"type":"integer","minimum":1}}},
    "publication":{"type":"object","required":["outcome","cleanup"],"properties":{"outcome":{"const":"complete"},"cleanup":{"const":"verified"}},"additionalProperties":false}
  }
}
