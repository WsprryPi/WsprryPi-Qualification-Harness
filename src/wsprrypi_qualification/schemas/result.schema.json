{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WsprryPi/WsprryPi-Qualification-Harness/schemas/result.schema.json",
  "title": "WsprryPi qualification result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "started_utc", "preflight_passed", "carrier_gate", "decode_gate", "cleanup_outcome", "failure_causes", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9](?:[a-z0-9._-]{0,61}[a-z0-9_-])$",
      "not": {"pattern": "\\.\\."}
    },
    "status": {"enum": ["qualified", "unqualified_carrier", "unqualified_decode", "fixture_blocked", "preflight_failed", "aborted", "cleanup_failed", "inconclusive"]},
    "started_utc": {"type": "string", "format": "date-time"},
    "completed_utc": {"type": "string", "format": "date-time"},
    "preflight_passed": {"type": "boolean"},
    "carrier_gate": {"enum": ["not_run", "passed", "failed", "blocked", "inconclusive"]},
    "decode_gate": {"enum": ["not_run", "passed", "failed", "blocked", "inconclusive"]},
    "cleanup_outcome": {"enum": ["not_required", "verified", "failed", "unknown"]},
    "failure_causes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["transmitter_carrier", "transmitter_decode", "receiver_unavailable", "receiver_overload", "rf_path_unsafe", "ownership_conflict", "unsupported_capability", "dependency_unavailable", "preflight", "operator_abort", "external_abort", "incomplete_evidence", "contradictory_evidence", "cleanup"]}
    },
    "reason": {"type": "string"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
