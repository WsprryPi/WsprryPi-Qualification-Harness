{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_type",
    "run_id",
    "output_parent",
    "time_scale",
    "child_timeout_s",
    "overall_timeout_s",
    "injection",
    "simulated",
    "external_access",
    "rf_enabled",
    "logical_duration_s",
    "logical_sample_rate_hz",
    "logical_sample_count",
    "physical_fixture_sample_rate_hz",
    "rf_off_fixture_sample_count",
    "rf_on_fixture_sample_count",
    "coherent_fixture_sample_count",
    "cf32_bytes_per_sample",
    "wav_sample_rate_hz",
    "wav_channels",
    "wav_sample_width_bytes",
    "wav_frame_count",
    "slot_count",
    "slot_spacing_s",
    "qualification_claim"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_type": {
      "const": "qualification_simulator"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "output_parent": {
      "type": "string",
      "minLength": 1
    },
    "time_scale": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "child_timeout_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    },
    "overall_timeout_s": {
      "type": "number",
      "minimum": 2,
      "maximum": 120
    },
    "injection": {
      "enum": [
        "none",
        "carrier_fail",
        "cleanup_fail",
        "rf_off_timeout",
        "rf_off_nonzero",
        "carrier_timeout",
        "carrier_nonzero",
        "frame_timeout",
        "frame_nonzero",
        "carrier_analysis_hang",
        "wav_hang",
        "decoder_hang",
        "publication_hang"
      ]
    },
    "simulated": {
      "const": true
    },
    "external_access": {
      "const": false
    },
    "rf_enabled": {
      "const": false
    },
    "logical_duration_s": {
      "const": 370
    },
    "logical_sample_rate_hz": {
      "const": 250000
    },
    "logical_sample_count": {
      "const": 92500000
    },
    "physical_fixture_sample_rate_hz": {
      "type": "integer",
      "minimum": 1
    },
    "rf_off_fixture_sample_count": { "const": 3072 },
    "rf_on_fixture_sample_count": { "const": 3072 },
    "coherent_fixture_sample_count": { "const": 243000 },
    "cf32_bytes_per_sample": { "const": 8 },
    "wav_sample_rate_hz": { "const": 1000 },
    "wav_channels": { "const": 1 },
    "wav_sample_width_bytes": { "const": 2 },
    "wav_frame_count": { "const": 1000 },
    "slot_count": { "const": 3 },
    "slot_spacing_s": { "const": 120 },
    "qualification_claim": {
      "const": false
    }
  }
}
