{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_type",
    "run_id",
    "output_parent",
    "time_scale",
    "child_timeout_s",
    "overall_timeout_s",
    "injection",
    "simulated",
    "external_access",
    "rf_enabled"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_type": {
      "const": "qualification_simulator"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "output_parent": {
      "type": "string",
      "minLength": 1
    },
    "time_scale": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "child_timeout_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    },
    "overall_timeout_s": {
      "type": "number",
      "minimum": 2,
      "maximum": 120
    },
    "injection": {
      "enum": [
        "none",
        "carrier_fail",
        "cleanup_fail",
        "rf_off_timeout",
        "rf_off_nonzero",
        "carrier_timeout",
        "carrier_nonzero",
        "frame_timeout",
        "frame_nonzero",
        "carrier_analysis_hang",
        "wav_hang",
        "decoder_hang",
        "publication_hang"
      ]
    },
    "simulated": {
      "const": true
    },
    "external_access": {
      "const": false
    },
    "rf_enabled": {
      "const": false
    }
  }
}
