{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "phase",
    "prepared_sha256",
    "components",
    "pending",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "prepared-release-state"
    },
    "phase": {
      "enum": [
        "preparing",
        "not_ready",
        "prepared",
        "partially_published",
        "acceptance_pending",
        "complete"
      ]
    },
    "prepared_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "components": {
      "type": "object"
    },
    "pending": {
      "type": [
        "object",
        "null"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
