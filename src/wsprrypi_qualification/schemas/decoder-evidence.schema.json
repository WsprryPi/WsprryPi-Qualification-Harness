{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/WsprryPi/WsprryPi-Qualification-Harness/schemas/decoder-evidence.schema.json",
  "$defs":{
    "artifact":{"type":"object","additionalProperties":false,"required":["path","size_bytes","sha256"],"properties":{"path":{"type":"string","minLength":1},"size_bytes":{"type":"integer","minimum":0},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "profileArtifact":{"type":"object","additionalProperties":false,"required":["path","size_bytes","sha256","id","schema_version"],"properties":{"path":{"type":"string","minLength":1},"size_bytes":{"type":"integer","minimum":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"id":{"type":"string","minLength":1},"schema_version":{"const":1}}},
    "profiles":{"type":"object","additionalProperties":false,"required":["bench","test","resolved"],"properties":{"bench":{"$ref":"#/$defs/profileArtifact"},"test":{"$ref":"#/$defs/profileArtifact"},"resolved":{"type":"object","additionalProperties":false,"required":["receiver","requested_frequency_hz","receiver_center_hz","receiver_gain_db","identity","gates","frame_count","random_offset_enabled"],"properties":{"receiver":{"type":"object","additionalProperties":false,"required":["transport","driver","sample_rate_hz","bandwidth_hz","sample_format","agc","bias_tee"],"properties":{"transport":{"enum":["local","ssh"]},"host":{"type":"string"},"driver":{"type":"string"},"serial":{"type":"string"},"channel":{"type":"integer","minimum":0},"sample_rate_hz":{"type":"integer","minimum":1},"bandwidth_hz":{"type":"integer","minimum":1},"sample_format":{"const":"CF32"},"agc":{"const":false},"bias_tee":{"const":false}}},"requested_frequency_hz":{"type":"number","exclusiveMinimum":0},"receiver_center_hz":{"type":"number","exclusiveMinimum":0},"receiver_gain_db":{"type":"number"},"identity":{"type":"object","additionalProperties":false,"required":["callsign","grid","power_dbm"],"properties":{"callsign":{"type":"string"},"grid":{"type":"string"},"power_dbm":{"type":"integer"}}},"gates":{"type":"object","additionalProperties":false,"required":["carrier_offset_max_hz","best_20hz_share_min","required_consecutive_decodes"],"properties":{"carrier_offset_max_hz":{"type":"number"},"best_20hz_share_min":{"type":"number"},"required_consecutive_decodes":{"type":"integer","minimum":1}}},"frame_count":{"type":"integer","minimum":1},"random_offset_enabled":{"const":false}}}}},
    "capture":{"type":"object","additionalProperties":false,"required":["path","size_bytes","sha256","capture_id","retained_capture_start_utc","retained_sample_count"],"properties":{"path":{"type":"string"},"size_bytes":{"type":"integer","minimum":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"capture_id":{"type":"string"},"retained_capture_start_utc":{"type":"string","format":"date-time"},"retained_sample_count":{"type":"integer","minimum":1}}}
  },
  "type":"object","additionalProperties":false,
  "required":["schema_version","evidence_type","slot_utc","wav","wav_filename","wav_format","tool","arguments","timeout_s","timed_out","return_code","stdout","stderr","decodes","malformed_candidate_lines","expected_identity","expected_identity_found","expected_intended_signal_found","gate_outcome","failure_causes","profiles","capture","audio_evidence","decoder_data_directory","decoder_data_artifacts"],
  "properties":{
    "schema_version":{"const":1},"evidence_type":{"const":"wsprd_execution"},"slot_utc":{"type":"string","format":"date-time","pattern":"Z$"},"wav":{"$ref":"#/$defs/artifact"},"wav_filename":{"type":"string","pattern":"^[0-9]{8}T[0-9]{6}Z\\.wav$"},
    "wav_format":{"type":"object","additionalProperties":false,"required":["channels","sample_width_bytes","sample_rate_hz","frame_count"],"properties":{"channels":{"const":1},"sample_width_bytes":{"const":2},"sample_rate_hz":{"type":"integer","minimum":1},"frame_count":{"type":"integer","minimum":1}}},
    "tool":{"type":"object","additionalProperties":false,"required":["path","sha256","version_query"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"version_query":{"type":"object","additionalProperties":false,"required":["arguments","return_code","stdout","stderr","timed_out","launch_error","version","unavailable_reason"],"properties":{"arguments":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"string"}},"return_code":{"type":["integer","null"]},"stdout":{"type":"string"},"stderr":{"type":"string"},"timed_out":{"type":"boolean"},"launch_error":{"type":["string","null"]},"version":{"type":["string","null"]},"unavailable_reason":{"type":["string","null"]}}}}},"arguments":{"type":"array","minItems":4,"items":{"type":"string"}},"timeout_s":{"type":"number","exclusiveMinimum":0},"timed_out":{"type":"boolean"},"return_code":{"type":["integer","null"]},"stdout":{"type":"string"},"stderr":{"type":"string"},
    "decodes":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["line_number","raw","decoder_time_token","snr_db","dt_s","frequency_mhz","drift_hz_per_min","callsign","grid","power_dbm","signal_role"],"properties":{"line_number":{"type":"integer","minimum":1},"raw":{"type":"string"},"decoder_time_token":{"type":"string","pattern":"^(?:[0-2][0-9][0-5][0-9]|[0-9]{3}Z)$"},"snr_db":{"type":"integer"},"dt_s":{"type":"number"},"frequency_mhz":{"type":"number"},"drift_hz_per_min":{"type":"integer"},"callsign":{"type":"string"},"grid":{"type":"string"},"power_dbm":{"type":"integer"},"signal_role":{"enum":["intended","companion_or_conjugate_image"]}}}},
    "malformed_candidate_lines":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["line_number","raw"],"properties":{"line_number":{"type":"integer","minimum":1},"raw":{"type":"string"}}}},"expected_identity":{"type":"object","additionalProperties":false,"required":["callsign","grid","power_dbm"],"properties":{"callsign":{"type":"string"},"grid":{"type":"string"},"power_dbm":{"type":"integer"}}},"expected_identity_found":{"type":"boolean"},"expected_intended_signal_found":{"type":"boolean"},"gate_outcome":{"enum":["passed","failed","blocked"]},"failure_causes":{"type":"array","items":{"enum":["decoder_timeout","decoder_nonzero_return","malformed_decoder_output","expected_identity_missing","expected_intended_signal_missing"]},"uniqueItems":true},"profiles":{"$ref":"#/$defs/profiles"},"capture":{"$ref":"#/$defs/capture"},"audio_evidence":{"$ref":"#/$defs/artifact"},"decoder_data_directory":{"type":"string","minLength":1},"decoder_data_artifacts":{"type":"array","items":{"$ref":"#/$defs/artifact"}}
  }
}
