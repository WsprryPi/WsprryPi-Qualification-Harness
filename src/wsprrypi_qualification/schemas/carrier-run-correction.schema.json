{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_type", "correction_run_id", "created_utc", "anchor_sha256", "original", "authorization_evidence", "rf_path", "cleanup_evidence", "preserved_result"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_type": {"const": "bounded_carrier_run_correction"},
    "correction_run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-bounded-carrier-20m(?:-retry)?-correction-2$"},
    "created_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "anchor_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "original": {"type": "object", "additionalProperties": false, "required": ["run_id", "path", "unchanged"], "properties": {"run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-bounded-carrier-20m(?:-retry)?$"}, "path": {"type": "string", "minLength": 1}, "unchanged": {"const": true}}},
    "authorization_evidence": {"$ref": "carrier-runtime-authorization.schema.json"},
    "rf_path": {"type": "object", "additionalProperties": false, "required": ["path_type", "antenna_connected", "termination", "attenuation_db", "filter", "safe_input_basis"], "properties": {"path_type": {"const": "radiated"}, "antenna_connected": {"const": true}, "termination": {"type": "null"}, "attenuation_db": {"type": "null"}, "filter": {"const": "None"}, "safe_input_basis": {"const": "N/A"}}},
    "cleanup_evidence": {"type": "object", "additionalProperties": false, "required": ["in_run_cleanup_outcome", "retrospective_annotation_authority", "later_recovery_changes_result"], "properties": {"in_run_cleanup_outcome": {"enum": ["verified", "failed"]}, "retrospective_annotation_authority": {"const": "unsupported_summary_not_used_for_classification"}, "later_recovery_changes_result": {"const": false}}},
    "preserved_result": {"type": "object", "additionalProperties": false, "required": ["status", "carrier_gate", "decode_gate", "frames_started"], "properties": {"status": {"enum": ["cleanup_failed", "unqualified_carrier"]}, "carrier_gate": {"enum": ["not_run", "failed"]}, "decode_gate": {"const": "not_run"}, "frames_started": {"const": false}}}
  }
}
