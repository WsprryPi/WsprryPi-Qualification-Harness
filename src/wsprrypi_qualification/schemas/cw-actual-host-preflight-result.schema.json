{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_type", "run_id", "created_utc", "read_only", "host_connections_performed", "rf_or_hardware_operation_performed", "qualification_claim", "host_results", "blockers", "overall_outcome", "next_phase_authorized"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_type": {"const": "cw_actual_host_preflight_result"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+$"},
    "created_utc": {"type": "string", "format": "date-time"},
    "read_only": {"const": true},
    "host_connections_performed": {"type": "boolean"},
    "rf_or_hardware_operation_performed": {"const": false},
    "qualification_claim": {"const": false},
    "host_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host_id", "checks"],
        "properties": {
          "host_id": {"type": "string"},
          "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}}
        }
      }
    },
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "overall_outcome": {"enum": ["ready", "blocked"]},
    "next_phase_authorized": {"const": false}
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "expected", "observed", "outcome", "diagnostic"],
      "properties": {
        "check_id": {"type": "string"},
        "expected": {"type": "string"},
        "observed": {"type": "string"},
        "outcome": {"enum": ["passed", "failed", "blocked", "unsupported"]},
        "diagnostic": {"type": "string"}
      }
    }
  }
}
