{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WsprryPi/WsprryPi-Qualification-Harness/schemas/test-profile.schema.json",
  "title": "WsprryPi qualification test profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "test_id", "transmitter", "band", "frequency_hz", "receiver_center_hz", "receiver_gain_db", "identity", "gates", "stopping_procedure", "frame_count", "random_offset_enabled"],
  "properties": {
    "schema_version": {"const": 1},
    "test_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,61}[a-z0-9_-])$",
      "not": {"pattern": "\\.\\."}
    },
    "transmitter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "host", "backend", "output"],
      "properties": {
        "transport": {"enum": ["local", "ssh"]},
        "host": {"type": "string", "minLength": 1},
        "backend": {"enum": ["gpio", "si5351", "rp1_gpclk"]},
        "output": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "hardware_description": {"type": "string", "minLength": 1},
        "oscillator_description": {"type": "string", "minLength": 1},
        "reference_frequency_hz": {"type": "integer", "minimum": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "submodule_revision": {"type": "string", "minLength": 1},
        "i2c_bus": {"type": "integer", "minimum": 0},
        "i2c_address": {"type": "string", "pattern": "^0x[0-9A-Fa-f]{2}$"},
        "drive_ma": {"type": "integer", "minimum": 1},
        "gpio_pin": {"type": "integer", "minimum": 0},
        "power_level": {"type": "integer", "minimum": 0},
        "pacing_clocks": {"type": "integer", "minimum": 1}
      }
    },
    "band": {"type": "string", "minLength": 1},
    "frequency_hz": {"type": "number", "exclusiveMinimum": 0},
    "receiver_center_hz": {"type": "number", "exclusiveMinimum": 0},
    "receiver_gain_db": {"type": "number"},
    "ppm": {"type": "number"},
    "frame_count": {"type": "integer", "minimum": 1},
    "bounded_duration_s": {"type": "integer", "minimum": 1},
    "random_offset_enabled": {"const": false},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callsign", "grid", "power_dbm"],
      "properties": {
        "callsign": {"type": "string", "pattern": "^[A-Z0-9/]{3,12}$"},
        "grid": {"type": "string", "pattern": "^[A-R]{2}[0-9]{2}([A-X]{2})?$"},
        "power_dbm": {"type": "integer"}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["carrier_offset_max_hz", "best_20hz_share_min", "required_consecutive_decodes"],
      "properties": {
        "carrier_offset_max_hz": {"type": "number", "minimum": 0},
        "best_20hz_share_min": {"type": "number", "minimum": 0, "maximum": 1},
        "required_consecutive_decodes": {"type": "integer", "minimum": 1}
      }
    },
    "stopping_procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transmitter_termination", "receiver_termination", "operator_abort", "cleanup_expectation", "emergency_stop_note"],
      "properties": {
        "transmitter_termination": {"type": "string", "minLength": 1},
        "receiver_termination": {"type": "string", "minLength": 1},
        "operator_abort": {"type": "string", "minLength": 1},
        "cleanup_expectation": {"type": "string", "minLength": 1},
        "emergency_stop_note": {"type": "string", "minLength": 1}
      }
    }
  }
}
