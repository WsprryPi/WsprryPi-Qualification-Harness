{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_type",
    "run_id",
    "mode",
    "plan",
    "generator",
    "protocol_definition",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evidence_type": {
      "const": "cw_expected_events"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "tone",
        "cw",
        "qrss",
        "fskcw",
        "dfcw"
      ]
    },
    "plan": {
      "$ref": "#/$defs/artifact"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "name",
        "version",
        "source_revision"
      ],
      "properties": {
        "origin": {
          "const": "harness_generated"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "protocol_definition": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "repetition",
          "message_position",
          "symbol",
          "role",
          "start_s",
          "end_s",
          "rf_state",
          "frequency_hz",
          "continuity_required"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "repetition": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "message_position": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "symbol": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "enum": [
              "quiet",
              "carrier",
              "dot",
              "dash",
              "intra_element_gap",
              "inter_character_gap",
              "inter_word_gap",
              "mark",
              "space",
              "transition"
            ]
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rf_state": {
            "enum": [
              "off",
              "primary",
              "secondary"
            ]
          },
          "frequency_hz": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "continuity_required": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
