{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "host": {
      "type": "string",
      "minLength": 1
    },
    "expected_hostname": {
      "type": "string",
      "minLength": 1
    },
    "home": {
      "type": "string",
      "minLength": 1
    },
    "known_hosts": {
      "type": "string",
      "minLength": 1
    },
    "evidence_root": {
      "type": "string",
      "minLength": 1
    },
    "remote_lock": {
      "type": "string",
      "minLength": 1
    },
    "baseline_local": {
      "type": "string",
      "minLength": 1
    },
    "baseline_remote": {
      "type": "string",
      "minLength": 1
    },
    "provider_source": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "baseline_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider_tooling_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "eligible_kernels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owned_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "installer_url": {
      "const": "https://raw.githubusercontent.com/WsprryPi/WsprryPi/refs/heads/devel/scripts/install.sh"
    },
    "settings_fixture": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "WSPR": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "Call Sign": {
              "type": "string",
              "minLength": 1
            },
            "Grid Square": {
              "type": "string",
              "minLength": 1
            },
            "TX Power": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60
            }
          }
        },
        "CW": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "Message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          }
        }
      }
    },
    "target_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine_id_sha256",
        "hostname",
        "os_id",
        "os_version",
        "kernel",
        "board_model"
      ],
      "properties": {
        "machine_id_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "os_id": {
          "type": "string",
          "minLength": 1
        },
        "os_version": {
          "type": "string",
          "minLength": 1
        },
        "kernel": {
          "type": "string",
          "minLength": 1
        },
        "board_model": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "required": [
    "host",
    "expected_hostname",
    "home",
    "known_hosts",
    "evidence_root",
    "remote_lock",
    "baseline_local",
    "baseline_remote",
    "provider_source",
    "baseline_sha256",
    "candidate_sha256",
    "provider_tooling_sha256",
    "eligible_kernels",
    "owned_paths",
    "target_identity"
  ]
}
