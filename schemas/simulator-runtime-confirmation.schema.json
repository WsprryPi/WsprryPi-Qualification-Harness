{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["simulated", "operator_confirmation_required", "rf_authorized", "plan_sha256"],
  "properties": {
    "simulated": {"const": true},
    "operator_confirmation_required": {"const": false},
    "rf_authorized": {"const": false},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
