{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_type",
    "campaign_id",
    "transmitter_host",
    "receiver_host",
    "sdr_selector",
    "transmitter_route",
    "sdr_discovery",
    "delegation_receipt",
    "execution_policy",
    "authorization",
    "configuration",
    "defaults",
    "resolved_values",
    "transmitter_ppm_resolution",
    "derived_frequencies",
    "receiver_tuning",
    "mode_order",
    "mode_plans",
    "topology",
    "transport",
    "campaign_deadline_s",
    "execution_paths",
    "input_store",
    "production_adapters_constructed",
    "qualification_claim"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evidence_type": {
      "const": "resolved_complete_test_plan"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "transmitter_host": {
      "type": "string",
      "minLength": 1
    },
    "receiver_host": {
      "type": "string",
      "minLength": 1
    },
    "sdr_selector": {
      "type": "string",
      "minLength": 1
    },
    "transmitter_route": {"enum": [null, "gpio4", "gpio20"]},
    "sdr_discovery": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "delegation_receipt": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/delegation_receipt"
        }
      ]
    },
    "execution_policy": {
      "enum": [
        "hardware_free",
        "live"
      ]
    },
    "authorization": {
      "const": "deliberate_invocation"
    },
    "configuration": {
      "$ref": "#/$defs/binding"
    },
    "defaults": {
      "$ref": "#/$defs/values"
    },
    "resolved_values": {
      "$ref": "#/$defs/values"
    },
    "transmitter_ppm_resolution": {"$ref": "#/$defs/ppmResolution"},
    "derived_frequencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wspr_dial_frequency_hz",
        "wspr_audio_offset_hz",
        "fskcw_secondary_frequency_hz",
        "dfcw_secondary_frequency_hz"
      ],
      "properties": {
        "wspr_dial_frequency_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "wspr_audio_offset_hz": {
          "const": 1500
        },
        "fskcw_secondary_frequency_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dfcw_secondary_frequency_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "receiver_tuning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "requested_frequency_hz",
        "center_frequency_hz",
        "tuning_offset_hz",
        "dc_exclusion_hz",
        "target_search_half_width_hz",
        "usable_half_span_hz"
      ],
      "properties": {
        "policy": {"const": "zero_if_offset_target_window_v1"},
        "requested_frequency_hz": {"type": "number", "exclusiveMinimum": 0},
        "center_frequency_hz": {"type": "number", "exclusiveMinimum": 0},
        "tuning_offset_hz": {"const": 25000.0},
        "dc_exclusion_hz": {"const": 1000.0},
        "target_search_half_width_hz": {"const": 500.0},
        "usable_half_span_hz": {"const": 100000.0}
      }
    },
    "mode_order": {
      "const": [
        "TONE",
        "WSPR",
        "QRSS",
        "FSKCW",
        "DFCW"
      ]
    },
    "mode_plans": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "source",
          "plan",
          "plan_sha256",
          "production_route"
        ],
        "properties": {
          "mode": {
            "enum": [
              "TONE",
              "WSPR",
              "QRSS",
              "FSKCW",
              "DFCW"
            ]
          },
          "source": {
            "$ref": "#/$defs/artifact"
          },
          "plan": {
            "type": "object"
          },
          "plan_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "production_route": {
            "enum": [
              "real_session",
              "live_keyed"
            ]
          }
        }
      }
    },
    "topology": {
      "enum": ["split_host_ssh", "same_host_roles"]
    },
    "transport": {
      "enum": ["ssh", "local_role_channels"]
    },
    "campaign_deadline_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "execution_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ssh_executable",
        "work_directory",
        "output_parent"
      ],
      "properties": {
        "ssh_executable": {
          "$ref": "#/$defs/artifact"
        },
        "work_directory": {
          "type": "string",
          "minLength": 1
        },
        "output_parent": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input_store": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "ownership",
        "retention",
        "cleanup"
      ],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "ownership": {
          "const": "campaign"
        },
        "retention": {
          "const": "retain_while_campaign_or_subordinate_result_exists"
        },
        "cleanup": {
          "const": "manual_only"
        }
      }
    },
    "production_adapters_constructed": {
      "const": false
    },
    "qualification_claim": {
      "const": false
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "delegation_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launcher",
        "module"
      ],
      "properties": {
        "launcher": {
          "$ref": "#/$defs/artifact"
        },
        "module": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "delegation_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiver_host",
        "ssh",
        "known_hosts",
        "remote_exec",
        "qualification"
      ],
      "properties": {
        "receiver_host": {
          "type": "string",
          "minLength": 1
        },
        "ssh": {
          "$ref": "#/$defs/artifact"
        },
        "known_hosts": {
          "$ref": "#/$defs/artifact"
        },
        "remote_exec": {
          "$ref": "#/$defs/delegation_identity"
        },
        "qualification": {
          "$ref": "#/$defs/delegation_identity"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "document"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "document": {
          "type": "object"
        }
      }
    },
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "band",
        "frequency_hz",
        "callsign",
        "grid",
        "power_dbm",
        "message",
        "qrss_dot_seconds",
        "fskcw_dot_seconds",
        "dfcw_dot_seconds",
        "fskcw_separation_hz",
        "dfcw_separation_hz",
        "keyed_observations",
        "wspr_observations"
        ,"carrier_offset_max_hz", "carrier_best_20hz_share_min", "gpio_manual_ppm", "transmitter_ppm_offset"
      ],
      "properties": {
        "band": {
          "type": "string",
          "minLength": 1
        },
        "frequency_hz": {
          "type": "integer",
          "minimum": 1501
        },
        "callsign": {
          "type": "string",
          "minLength": 1
        },
        "grid": {
          "type": "string",
          "minLength": 1
        },
        "power_dbm": {
          "type": "integer"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "qrss_dot_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fskcw_dot_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dfcw_dot_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fskcw_separation_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dfcw_separation_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "keyed_observations": {
          "const": 3
        },
        "wspr_observations": {
          "const": 3
        },
        "carrier_offset_max_hz": {"type": "number", "minimum": 0},
        "carrier_best_20hz_share_min": {"type": "number", "minimum": 0, "maximum": 1},
        "gpio_manual_ppm": {"type": ["number", "null"], "minimum": -200, "maximum": 200},
        "transmitter_ppm_offset": {"type": "number", "minimum": -200, "maximum": 200}
      }
    },
    "ppmResolution": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "resolved_utc", "transmitter_host", "backend", "contributors", "host_correction_ppm", "harness_offset_ppm", "effective_correction_ppm", "derivation", "application", "receiver_calibration_separate"],
      "properties": {
        "algorithm": {"const": "host_absolute_precedence_plus_harness_delta_v1"},
        "resolved_utc": {"type": "string", "format": "date-time"},
        "transmitter_host": {"type": "string", "minLength": 1}, "backend": {"enum": ["gpio", "si5351", "rp1_gpclk"]},
        "contributors": {"type": "array", "minItems": 2, "items": {"type": "object"}},
        "host_correction_ppm": {"type": "number", "minimum": -200, "maximum": 200},
        "harness_offset_ppm": {"type": "number", "minimum": -200, "maximum": 200},
        "effective_correction_ppm": {"type": "number", "minimum": -200, "maximum": 200},
        "derivation": {"type": "string", "minLength": 1},
        "application": {"const": "exactly_once_as_backend_ppm_argument"},
        "receiver_calibration_separate": {"const": true}
      }
    }
  }
}
