{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/WsprryPi/WsprryPi-Qualification-Harness/schemas/keyed-result.schema.json","type":"object","additionalProperties":false,"required":["schema_version","evidence_type","session_id","mode","plan_sha256","authorization_sha256","aggregate_sha256","transaction_outcomes","cleanup_verified","quiescence_verified","final_status","qualification_claim"],"properties":{"schema_version":{"const":1},"evidence_type":{"const":"keyed_result"},"session_id":{"type":"string","minLength":1},"mode":{"enum":["QRSS","FSKCW","DFCW"]},"plan_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"authorization_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"aggregate_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"transaction_outcomes":{"type":"array","minItems":1,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["transaction_number","transaction_id","final_outcome"],"properties":{"transaction_number":{"type":"integer","minimum":1,"maximum":3},"transaction_id":{"type":"string","minLength":1},"final_outcome":{"enum":["passed","failed","blocked","inconclusive","aborted","preflight_failed","cleanup_failed"]}}}},"cleanup_verified":{"type":"boolean"},"quiescence_verified":{"type":"boolean"},"final_status":{"enum":["qualified","unqualified_keyed","fixture_blocked","preflight_failed","aborted","cleanup_failed","inconclusive"]},"qualification_claim":{"type":"boolean"}}}
