{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "evidence_type", "runs"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_type": {"const": "bounded_carrier_original_anchors"},
    "runs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["run_id", "repository_relative_path", "manifest", "artifacts", "expected_result", "expected_carrier_gate", "expected_decode_gate", "expected_cleanup_outcome", "frame_artifacts_absent"], "properties": {"run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-bounded-carrier-20m(?:-retry)?$"}, "repository_relative_path": {"type": "string", "pattern": "^runs/[A-Za-z0-9._-]+$"}, "manifest": {"$ref": "#/$defs/artifact"}, "artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}}, "expected_result": {"enum": ["cleanup_failed", "unqualified_carrier"]}, "expected_carrier_gate": {"enum": ["not_run", "failed"]}, "expected_decode_gate": {"const": "not_run"}, "expected_cleanup_outcome": {"enum": ["failed", "verified"]}, "frame_artifacts_absent": {"const": true}}}}
  },
  "$defs": {"artifact": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"}, "size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
