{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_type", "run_id", "controller_revision", "gate_d_status", "timeout_seconds", "known_blockers", "rf_path", "hosts"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_type": {"const": "cw_actual_host_preflight_plan"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+$"},
    "controller_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "transmitter_backend": {"enum": ["legacy_gpio", "rp1_gpclk", "si5351"]},
    "gate_d_status": {"enum": ["complete", "incomplete", "not_applicable"]},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
    "known_blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rf_path": {
      "type": "object", "additionalProperties": false,
      "required": ["declared_current", "antenna_state", "termination", "attenuation", "safe_input_basis"],
      "properties": {
        "declared_current": {"type": "boolean"}, "antenna_state": {"type": "string", "minLength": 1},
        "termination": {"type": "string", "minLength": 1}, "attenuation": {"type": "string", "minLength": 1},
        "safe_input_basis": {"type": "string", "minLength": 1}
      }
    },
    "hosts": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["host_id", "role", "ssh_destination", "host_key_alias", "expected_hostname", "expected_model", "expected_revision_hex", "repository_path", "expected_repository_revision", "required_binaries", "required_groups", "inspect_services", "conflicting_process_names"],
        "properties": {
          "host_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "role": {"enum": ["transmitter", "receiver", "controller", "combined"]},
          "ssh_destination": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_.-]+$"},
          "host_key_alias": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "expected_hostname": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "expected_model": {"type": "string", "minLength": 1},
          "expected_revision_hex": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
          "repository_path": {"type": "string", "pattern": "^/[A-Za-z0-9_.+/-]+$"},
          "expected_repository_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "required_binaries": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"}},
          "required_groups": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}},
          "inspect_services": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.@-]+\\.service$"}},
          "conflicting_process_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"}}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"gate_d_status": {"const": "not_applicable"}}},
      "then": {
        "required": ["transmitter_backend"],
        "properties": {"transmitter_backend": {"enum": ["legacy_gpio", "si5351"]}}
      }
    },
    {
      "if": {"properties": {"transmitter_backend": {"const": "rp1_gpclk"}}, "required": ["transmitter_backend"]},
      "then": {"properties": {"gate_d_status": {"enum": ["complete", "incomplete"]}}}
    }
  ]
}
