{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["schema_version","plan_type","execution_mode","run_id","test_id","controller","capture_host","coordination_host","coordination_required","transport","capability_bindings","remote_helper","receiver","capture","rf_path","raw_iq_retention","deadlines","stopping_procedure","receiver_release_contract","artifact_policy","transmitter_operation_authorized"],
  "properties":{
    "schema_version":{"const":1},"plan_type":{"const":"resolved_receiver_integration"},"execution_mode":{"const":"hardware_free_validation"},
    "run_id":{"type":"string","pattern":"^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9][A-Za-z0-9._-]{0,79}$","not":{"pattern":"\\.\\."}},"test_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "controller":{"$ref":"#/$defs/host"},"capture_host":{"$ref":"#/$defs/host"},"coordination_host":{"oneOf":[{"$ref":"#/$defs/host"},{"type":"null"}]},"coordination_required":{"type":"boolean"},"transport":{"enum":["local","ssh"]},
    "capability_bindings":{"type":"object","additionalProperties":false,"required":["host","coordination","helper","soapy"],"properties":{"host":{"$ref":"#/$defs/hash"},"coordination":{"$ref":"#/$defs/hash"},"helper":{"$ref":"#/$defs/hash"},"soapy":{"$ref":"#/$defs/hash"}}},
    "remote_helper":{"type":"object","additionalProperties":false,"required":["host","path","sha256","identity","protocol_version"],"properties":{"host":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/hash"},"identity":{"type":"string","minLength":1},"protocol_version":{"type":"integer","minimum":1}}},
    "receiver":{"type":"object","additionalProperties":false,"required":["manufacturer","model","driver","serial","channel","module","module_version"],"properties":{"manufacturer":{"type":"string","minLength":1},"model":{"type":"string","minLength":1},"driver":{"type":"string","minLength":1},"serial":{"type":"string","minLength":1},"channel":{"type":"integer","minimum":0},"module":{"type":"string","minLength":1},"module_version":{"type":"string","minLength":1}}},
    "capture":{"type":"object","additionalProperties":false,"required":["sample_format","sample_rate_hz","bandwidth_hz","center_frequency_hz","gain_db","agc","bias_tee","clipping_threshold","first_read_discarded","sample_count","expected_byte_count","read_timeout_us"],"properties":{"sample_format":{"const":"CF32"},"sample_rate_hz":{"type":"integer","minimum":1},"bandwidth_hz":{"type":"integer","minimum":1},"center_frequency_hz":{"type":"number","exclusiveMinimum":0},"gain_db":{"type":"number"},"agc":{"const":false},"bias_tee":{"const":false},"clipping_threshold":{"type":"number","exclusiveMinimum":0,"maximum":1},"first_read_discarded":{"const":true},"sample_count":{"type":"integer","minimum":1},"expected_byte_count":{"type":"integer","minimum":8},"read_timeout_us":{"type":"integer","minimum":1}}},
    "rf_path":{"type":"object","additionalProperties":false,"required":["path_type","antenna_connected","termination","attenuation_db","filter","safe_input_basis"],"properties":{"path_type":{"enum":["radiated","conducted"]},"antenna_connected":{"type":"boolean"},"termination":{"type":["string","null"]},"attenuation_db":{"type":["number","null"],"minimum":0},"filter":{"type":["string","null"]},"safe_input_basis":{"type":"string","minLength":1}}},
    "raw_iq_retention":{"enum":["retain","externalize_after_review"]},
    "deadlines":{"type":"object","additionalProperties":false,"required":["helper_s","capture_s","cleanup_s","coordination_s","overall_s"],"properties":{"helper_s":{"type":"number","exclusiveMinimum":0},"capture_s":{"type":"number","exclusiveMinimum":0},"cleanup_s":{"type":"number","exclusiveMinimum":0},"coordination_s":{"type":"number","exclusiveMinimum":0},"overall_s":{"type":"number","exclusiveMinimum":0}}},
    "stopping_procedure":{"type":"string","minLength":1},"receiver_release_contract":{"type":"string","minLength":1},"artifact_policy":{"type":"string","minLength":1},"transmitter_operation_authorized":{"const":false}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"host":{"type":"object","additionalProperties":false,"required":["name","identity","source_revision"],"properties":{"name":{"type":"string","minLength":1},"identity":{"type":"string","minLength":1},"source_revision":{"type":"string","minLength":1}}}}
}
