#!/usr/bin/env python3
"""Collect one fail-closed, passive RP1 ABI-v4 preflight document."""

from __future__ import annotations

import grp
import gzip
import hashlib
import json
import lzma
import os
import pathlib
import platform
import pwd
import stat
import subprocess
import sys

MODULE = "rp1_gpclk_dkms"
ENDPOINT = pathlib.Path("/dev/rp1-gpclk")
ROUTES = {
    "gpio4": (4, "GPIO4", "rp1-gpclk-dkms-gpio4"),
    "gpio20": (20, "GPIO20", "rp1-gpclk-dkms-gpio20"),
}


def fail() -> int:
    return 3


def sha256(path: pathlib.Path, *, decompressed: bool = False) -> str:
    opener = (
        lzma.open
        if path.suffix == ".xz"
        else gzip.open
        if path.suffix == ".gz"
        else pathlib.Path.open
    )
    digest = hashlib.sha256()
    with opener(path, "rb") as stream:  # type: ignore[arg-type]
        while chunk := stream.read(1024 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def run(arguments: list[str]) -> str:
    result = subprocess.run(
        arguments, shell=False, check=False, capture_output=True, text=True, timeout=5
    )
    if result.returncode != 0:
        raise RuntimeError("passive inspection command failed")
    return result.stdout.strip()


def optional_text(path: pathlib.Path) -> str | None:
    try:
        return path.read_text(encoding="utf-8").rstrip("\x00\n")
    except OSError:
        return None


def observed_enrollments(
    root: pathlib.Path = pathlib.Path("/etc/rp1-gpclk-dkms/development"),
) -> list[dict[str, object]]:
    observations: list[dict[str, object]] = []
    for path in sorted(root.glob("*.json")):
        entry: dict[str, object] = {"path": str(path), "sha256": sha256(path)}
        try:
            document = json.loads(path.read_text(encoding="utf-8"))
            entry.update(
                status="parsed",
                source_commit=document.get("sourceCommit"),
                route=document.get("route"),
                module_version=document.get("moduleVersion"),
                manifest_sha256=document.get("sourceManifestSha256"),
            )
        except (OSError, json.JSONDecodeError):
            entry["status"] = "unreadable"
        observations.append(entry)
    return observations


def observed_device_tree(
    node: str, root: pathlib.Path = pathlib.Path("/proc/device-tree")
) -> dict[str, object]:
    matches = sorted(path for path in root.resolve().rglob(node) if path.is_dir())
    if len(matches) != 1:
        return {"status": "unavailable", "matching_node_count": len(matches)}
    path = matches[0]
    clocks = path / "clocks"
    clock_names = optional_text(path / "clock-names")
    return {
        "status": "observed",
        "path": str(path),
        "compatible": optional_text(path / "compatible"),
        "clock_names": [] if clock_names is None else clock_names.split("\x00"),
        "clock_specifiers_hex": None if not clocks.is_file() else clocks.read_bytes().hex(),
    }


def transmission_deployment_ready(output_inhibit: str, values: dict[str, str]) -> bool:
    return (
        output_inhibit in {"N", "0"}
        and values.get("output_inhibited") == "false"
        and values.get("operational_ready") == "true"
    )


def main() -> int:
    if len(sys.argv) != 3 or sys.argv[1] != "rp1-inspect":
        return 2
    try:
        request = json.loads(sys.argv[2])
        if request != {
            "acquire_endpoint": False,
            "read_only": True,
            "route": request.get("route"),
        }:
            return 2
        route = request["route"]
        gpio, _output, node = ROUTES[route]
        probe = pathlib.Path(__file__).with_name("rp1-admin-probe")
        values = dict(line.split("=", 1) for line in run([str(probe), str(gpio)]).splitlines())
        if values.get("passive_snapshot") != "ok" or values.get("read_only") != "true":
            return fail()
        endpoint_stat = ENDPOINT.stat()
        if not stat.S_ISCHR(endpoint_stat.st_mode):
            return fail()
        kernel = platform.release()
        modules = sorted(pathlib.Path(f"/lib/modules/{kernel}/updates/dkms").glob(f"{MODULE}.ko*"))
        if len(modules) != 1:
            return fail()
        module = modules[0]
        modinfo = {
            field: run(["/usr/sbin/modinfo", "-F", field, str(module)])
            for field in ("version", "vermagic", "signer")
        }
        output_inhibit = (
            pathlib.Path(f"/sys/module/{MODULE}/parameters/output_inhibit").read_text().strip()
        )
        compatibility_id = values["compatibility_id"]
        if not compatibility_id or not transmission_deployment_ready(output_inhibit, values):
            return fail()
        safe = values.get("gpio_safe") == "true"
        stable = values.get("stable") == "true"
        active_device_tree = observed_device_tree(node)
        if active_device_tree.get("status") != "observed":
            return fail()
        clock_names = active_device_tree.get("clock_names")
        operation_states = {0: "IDLE", 3: "COMPLETE"}
        terminal_reasons = {0: "NONE", 1: "COMPLETE", 2: "STOPPED", 3: "OWNER_CLOSED"}
        operation_state = operation_states.get(int(values["operation_state"]), "UNKNOWN")
        terminal_reason = terminal_reasons.get(int(values["terminal_reason"]), "UNKNOWN")
        document = {
            "host": platform.node(),
            "endpoint": str(ENDPOINT),
            "endpoint_type": "character",
            "endpoint_owner": pwd.getpwuid(endpoint_stat.st_uid).pw_name,
            "endpoint_group": grp.getgrgid(endpoint_stat.st_gid).gr_name,
            "endpoint_mode": f"{stat.S_IMODE(endpoint_stat.st_mode):04o}",
            "endpoint_device_identity": (
                f"{os.major(endpoint_stat.st_rdev)}:{os.minor(endpoint_stat.st_rdev)}"
            ),
            "endpoint_available": True,
            "endpoint_open": False,
            "owner_present": values["owner_present"] == "true",
            "lease_present": values["lease_present"] == "true",
            "module": MODULE,
            "module_version": modinfo["version"],
            "module_build_id": values["build_id"],
            "uapi_sha256": None,
            "vermagic": modinfo["vermagic"],
            "signer": modinfo["signer"] or "unsigned-development-module",
            "installed_module_sha256": sha256(module),
            "abi_version": 4,
            "query_version": 3,
            "finite_tone": True,
            # Retain the evidence-schema field while deriving it from the
            # current provider's passive operation state, not the retired
            # output_inhibit module parameter.
            "output_inhibited": False,
            "route": route,
            "endpoint_node": node,
            "compatibility_id": compatibility_id,
            "compatibility_state": values.get("compatibility_state", "observed"),
            "compatibility_reason": values["compatibility_reason"],
            "development_enrollment": "observed-not-required",
            "development_manifest_sha256": None,
            # Retained as non-authoritative legacy evidence. The current
            # provider exposes no global live-eligibility switch.
            "live_eligible": False,
            # The production provider no longer advertises the retired kernel
            # operation-live-gate capability. Exact operation authorization is
            # enforced by the root-owned endpoint and lease lifecycle.
            "root_only_endpoint": (
                endpoint_stat.st_uid == 0
                and endpoint_stat.st_gid == 0
                and stat.S_IMODE(endpoint_stat.st_mode) == 0o600
            ),
            "cleanup_fault": values["cleanup_fault"] == "true",
            "generation": int(values["generation"]),
            "operation_state": operation_state,
            "terminal_reason": terminal_reason,
            "current_event": "none",
            "elapsed_ns": 0,
            "remaining_ns": 0,
            "drain_complete": stable,
            "gpio_safe": safe,
            "clock_quiescent": values["clock_quiescent"] == "true",
            "dma_quiescent": values["dma_quiescent"] == "true",
            "unresolved_route_transaction": False,
            "route_state": {
                "requested": route,
                "saved": None,
                "configured": None,
                "active_overlay": route,
                "module_reported": None,
                "reconciled": None,
            },
            "observed_platform": {
                "observation_policy": "record_not_approve",
                "kernel": kernel,
                "board_model": optional_text(pathlib.Path("/proc/device-tree/model")),
                "module_srcversion": optional_text(
                    pathlib.Path(f"/sys/module/{MODULE}/srcversion")
                ),
                "module_file": str(module),
                "module_file_sha256": sha256(module),
                "enrollments": observed_enrollments(),
                "overlay": {
                    "path": f"/usr/lib/rp1-gpclk-dkms/runtime-overlays/{route}.dtbo",
                    "sha256": (
                        sha256(
                            pathlib.Path(f"/usr/lib/rp1-gpclk-dkms/runtime-overlays/{route}.dtbo")
                        )
                        if pathlib.Path(
                            f"/usr/lib/rp1-gpclk-dkms/runtime-overlays/{route}.dtbo"
                        ).is_file()
                        else None
                    ),
                },
                "active_device_tree": active_device_tree,
                "parent_clock": {
                    "identity": (
                        clock_names[0] if isinstance(clock_names, list) and clock_names else None
                    ),
                    "rate_hz": None,
                    "status": "device-tree-observed-runtime-rate-unavailable",
                },
            },
        }
        print(json.dumps(document, sort_keys=True))
        return 0
    except (
        KeyError,
        OSError,
        RuntimeError,
        ValueError,
        json.JSONDecodeError,
        subprocess.TimeoutExpired,
    ):
        return fail()


if __name__ == "__main__":
    raise SystemExit(main())
