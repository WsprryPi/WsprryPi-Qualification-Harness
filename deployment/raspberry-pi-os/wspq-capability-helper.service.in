[Unit]
Description=WsprryPi qualification capability helper
After=network.target

[Service]
Type=simple
User=REPLACE_WITH_DEDICATED_USER
Group=REPLACE_WITH_DEDICATED_GROUP
ExecStart=/opt/wsprrypi-qualification/venv/bin/wspq-capability-helper --serve --config /etc/wsprrypi-qualification/helper.json
WorkingDirectory=/var/lib/wsprrypi-qualification
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wsprrypi-qualification
Restart=no
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
